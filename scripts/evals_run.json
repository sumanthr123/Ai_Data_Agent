{
 "run_name": "consensus-agent-evals",
 "environments": [
  {
   "environment_key": "py",
   "spec": {
    "client": "2",
    "dependencies": [
     "-r /Workspace/Users/{{USER}}/consensus-agent-dev/requirements.txt",
     "nodejs-wheel==24.19.0"
    ]
   }
  }
 ],
 "tasks": [
  {
   "task_key": "checks",
   "environment_key": "py",
   "spark_python_task": {
    "source": "WORKSPACE",
    "python_file": "/Workspace/Users/{{USER}}/consensus-agent-dev/scripts/databricks_checks.py",
    "parameters": [
     "--root",
     "/Workspace/Users/{{USER}}/consensus-agent-dev",
     "--warehouse-id",
     "{{WAREHOUSE_ID}}",
     "--frontend",
     "--evals",
     "none",
     "--env",
     "DEFAULT_DATASET_SOURCE={{DEFAULT_DATASET}}",
     "--env",
     "EVAL_EXPERIMENT=/Users/{{USER}}/ai-data-agent-evals"
    ]
   }
  }
 ]
}
