# Reference list of the settings the backend reads (backend/ask/settings.py). Nothing runs on a workstation: on
# Databricks Apps these come from app.yaml and app resources, and in jobs from the job spec (scripts/*_run.json).
# Secrets (e.g. GEMINI_API_KEY) come from secret scopes via `valueFrom`, never from plain values. Never commit a .env.
DATABRICKS_HOST=https://<workspace>.cloud.databricks.com
DATABRICKS_CONFIG_PROFILE=<cli-profile>            # the CLI on a workstation only (scripts/env.sh)
DATABRICKS_WAREHOUSE_ID=<warehouse-id>             # DATABRICKS_SQL_WAREHOUSE_ID is also accepted
DEFAULT_DATASET_SOURCE=<catalog>.<schema>.<table>
UC_CATALOG=<catalog>
UC_SCHEMA=<schema>
UC_UPLOAD_VOLUME=uploads
ANALYST_MODEL_ENDPOINT=databricks-gpt-oss-120b
REVIEWER_MODEL_ENDPOINT=databricks-llama-4-maverick  # must be a different model family from the Analyst
ADJUDICATOR_MODEL_ENDPOINT=databricks-qwen35-122b-a10b  # first choice for the council's judge
COUNCIL_ENDPOINTS=databricks-gpt-oss-120b,databricks-llama-4-maverick  # Tier 2 members; add claude-sonnet-5-5 once it has credits
MODEL_CHOICES=databricks-gpt-oss-120b,databricks-llama-4-maverick,databricks-qwen35-122b-a10b,gemini-3-5-flash/gemini-3-5-flash,claude-sonnet-5-5/claude-sonnet-5-5
USE_USER_TOKEN=false                                # true: query as the signed-in user (needs app user authorization)

# Budgets per question (enforced in code)
MAX_MODEL_CALLS_PER_QUESTION=6
MAX_SQL_ATTEMPTS=3
MAX_TOTAL_MODEL_TOKENS=12000
MAX_RESULT_ROWS_TO_MODEL=50
MAX_RESULT_CHARS_TO_MODEL=4000
MAX_FINAL_ANSWER_WORDS=250
ANALYST_REASONING_EFFORT=low
REVIEWER_REASONING_EFFORT=
STATEMENT_TIMEOUT_S=45
ASK_REQUEST_TIMEOUT_S=150
RESULT_CACHE_TTL_S=300

# Optional
MLFLOW_EXPERIMENT=                                  # e.g. /Users/<you>/ai-data-assistant-traces
TRACE_CONTENT=false                                 # true keeps redacted question and prompt text in traces
MODEL_PRICES_JSON=                                  # {"endpoint": [usd_per_1M_input, usd_per_1M_output]}
BUSINESS_DEFINITIONS=                               # JSON {"metric": "definition"}; defaults in backend/ask/settings.py

# Uploads (Phase 2)
UC_UPLOAD_SCHEMA=user_uploads                       # app principal needs USE SCHEMA, CREATE TABLE, SELECT here
UPLOAD_MAX_MB=25
UPLOAD_MAX_COLUMNS=200
UPLOAD_MAX_SHEETS=20
UPLOAD_MAX_ROWS=500000
UPLOAD_TTL_HOURS=24
